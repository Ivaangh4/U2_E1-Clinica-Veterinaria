<?xml version="1.0" encoding="UTF-8"?>
<Configuration status="WARN">

    <Appenders>

        <File name="FileAppender"
              fileName="logs/clinica.log"
              append="true">

            <PatternLayout pattern="%d{yyyy-MM-dd HH:mm:ss} [%t] %-5level %logger{36} - %msg%n"/>

        </File>

    </Appenders>

    <Loggers>

        <Logger name="com.clinica.IMS.clinica" level="DEBUG" additivity="false">

            <AppenderRef ref="FileAppender"/>

        </Logger>

        <Root level="INFO">

            <AppenderRef ref="FileAppender"/>

        </Root>

    </Loggers>

</Configuration>